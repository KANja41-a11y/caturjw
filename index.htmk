<!-- index.html -->

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Catur Jawa</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <div class="app">

    <header>
      <div class="batik">❈ ❖ ❈</div>

      <p class="tagline">PERMAINAN TRADISIONAL NUSANTARA</p>

      <h1>Catur <em>Jawa</em></h1>

      <p class="intro">
        Adu strategi • 3 bidak • 1 pemenang
      </p>
    </header>


    <section class="game-card">

      <div class="players">

        <div class="player red active" id="redPlayer">

          <div class="piece-preview red-piece"></div>

          <div>
            <span>PEMAIN 1</span>
            <b>Merah</b>
          </div>

        </div>


        <div class="versus">
          <span>VS</span>
        </div>


        <div class="player blue" id="bluePlayer">

          <div class="piece-preview blue-piece"></div>

          <div>
            <span>PEMAIN 2</span>
            <b>Biru</b>
          </div>

        </div>

      </div>


      <div class="game-status">

        <div class="turn-indicator">
          <i id="turnDot"></i>

          <div>
            <small>GILIRAN SEKARANG</small>
            <strong id="turnName">Merah</strong>
          </div>
        </div>

        <p id="status">
          Pilih bidak merah yang ingin digerakkan.
        </p>

      </div>


      <div class="board-wrapper">

        <div class="board" id="board">

          <div class="wood-pattern"></div>

          <div class="connection c1"></div>
          <div class="connection c2"></div>
          <div class="connection c3"></div>
          <div class="connection c4"></div>
          <div class="connection c5"></div>
          <div class="connection c6"></div>
          <div class="connection c7"></div>
          <div class="connection c8"></div>
          <div class="connection c9"></div>
          <div class="connection c10"></div>

          <button class="slot" data-id="0"></button>
          <button class="slot" data-id="1"></button>
          <button class="slot" data-id="2"></button>

          <button class="slot" data-id="3"></button>
          <button class="slot" data-id="4"></button>
          <button class="slot" data-id="5"></button>

          <button class="slot" data-id="6"></button>
          <button class="slot" data-id="7"></button>
          <button class="slot" data-id="8"></button>

        </div>

      </div>


      <div class="scoreboard">

        <div class="score red-score">
          <span class="dot"></span>
          <small>MERAH</small>
          <b id="redScore">0</b>
        </div>

        <div class="round">
          <small>RONDE</small>
          <b id="round">01</b>
        </div>

        <div class="score blue-score">
          <span class="dot"></span>
          <small>BIRU</small>
          <b id="blueScore">0</b>
        </div>

      </div>


      <div class="buttons">

        <button id="newGame" class="main-button">
          Permainan Baru
        </button>

      </div>

    </section>


    <footer>
      <span>❈</span>
      Catur Jawa
      <span>❈</span>
    </footer>

  </div>


  <div class="winner-overlay" id="winnerOverlay">

    <div class="winner-box">

      <div class="trophy">♛</div>

      <small>PEMENANG RONDE</small>

      <h2 id="winnerName">Merah</h2>

      <div id="winnerPiece" class="winner-piece"></div>

      <button id="continueButton">
        Lanjut Bermain
      </button>

    </div>

  </div>


  <script src="script.js"></script>

</body>
</html>
